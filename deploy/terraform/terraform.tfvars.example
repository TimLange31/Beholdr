image        = "registry.example.com/beholdr:0.1.0"
namespace    = "beholdr"
ingress_host = "beholdr.example.com"
ingress_class = "nginx"

# Required: TLS. This must name a real secret (e.g. one cert-manager creates
# from the cluster-issuer annotation below); otherwise apply fails unless you
# explicitly set insecure_http = true.
tls_secret_name = "beholdr-tls"
ingress_annotations = {
  "cert-manager.io/cluster-issuer" = "letsencrypt-prod"
}

# Required: authentication. Beholdr has no built-in login, so an OIDC-aware
# proxy must sit in front of it; otherwise apply fails unless you explicitly
# set insecure_no_auth = true. Example using oauth2-proxy:
auth_annotations = {
  "nginx.ingress.kubernetes.io/auth-url"    = "https://oauth2-proxy.example.com/oauth2/auth"
  "nginx.ingress.kubernetes.io/auth-signin" = "https://oauth2-proxy.example.com/oauth2/start?rd=$scheme://$host$request_uri"
}

# Restrict to specific namespaces (empty = whole cluster)
# watch_namespaces = ["production", "staging"]

# Only set this if a separately-hosted frontend needs to call the API
# cross-origin. Empty (the default) disables CORS entirely.
# cors_origins = ["https://dashboard.example.com"]

# External telemetry integrations. Credentials reference existing Kubernetes
# Secrets and are never placed in Terraform variables/state.
# prometheus_url                      = "http://prometheus.monitoring.svc.cluster.local:9090"
# prometheus_bearer_token_secret_name = "beholdr-prometheus"
# elasticsearch_url                   = "https://example.es.europe-west1.gcp.cloud.es.io"
# elasticsearch_api_key_secret_name   = "beholdr-elasticsearch"
# otel_collector_health_url           = "http://beholdr-otel-collector.beholdr.svc.cluster.local:13133/"

# --- TLS termination ---------------------------------------------------------
#
# Default (tls_mode = "cluster"): the Ingress serves the certificate named in
# tls_secret_name. This also covers Cloudflare Full and Full (strict) — put a
# Cloudflare Origin CA certificate in that secret and keep ssl-redirect on.
#
# Cloudflare Flexible SSL, a Cloudflare Tunnel, or any external load balancer
# that terminates TLS and forwards plain HTTP: no certificate or key is needed
# in the cluster at all. Switch modes rather than setting insecure_http, which
# would also disable the origin-side redirect handling this mode gets right.
# tls_mode            = "edge"
# edge_tls_terminator = "cloudflare"
# tls_secret_name     = ""   # must stay empty in edge mode
#
# In edge mode the origin answers plain HTTP, so restrict who may reach it —
# otherwise anything that can route to the Ingress bypasses Cloudflare and any
# access control in front of it. Current list: https://www.cloudflare.com/ips/
# (a Cloudflare Tunnel avoids origin exposure altogether and needs no ranges).
# edge_source_ranges = [
#   "173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22",
#   "141.101.64.0/18", "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20",
#   "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13",
#   "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22",
#   "2400:cb00::/32", "2606:4700::/32", "2803:f800::/32", "2405:b500::/32",
#   "2405:8100::/32", "2a06:98c0::/29", "2c0f:f248::/32",
# ]

# --- Outbound TLS trust for the integrations ---------------------------------
# Needed when a backend presents a certificate the system trust store does not
# know: an ECK-issued Elasticsearch cert, a Cloudflare Origin CA cert, a
# corporate PKI. One Secret, one key per backend, mounted at /etc/beholdr/ca.
# integration_ca_secret_name  = "beholdr-integration-ca"
# elasticsearch_ca_secret_key = "elastic-ca.crt"
# prometheus_ca_secret_key    = "prometheus-ca.crt"
#
# Last resort only, when the CA genuinely cannot be obtained. Beholdr logs this
# at WARN on startup and marks the provider unverified in the UI.
# elasticsearch_tls_insecure = true
