+            # - { name: BEHOLDR_SERVICE_KUBE_POD_LABEL, value: "pod" }
+            #
+            # CPU is scored against limits by default, where over 100% means
+            # throttling. Switch to requests only with thresholds that suit it:
+            # requests are a scheduling floor, and healthy bursty services sit
+            # well above 100% of request.
+            # - { name: BEHOLDR_SERVICE_CPU_BASIS, value: "requests" }
+            # - { name: BEHOLDR_SERVICE_CPU_WARNING, value: "150" }
