+            # these are what keep a busy incident from loading the Prometheus
+            # you are debugging with.
+            - { name: BEHOLDR_SERVICE_METRICS_CACHE_TTL, value: "30" }
+            - { name: BEHOLDR_SERVICE_MAX_CONCURRENT_QUERIES, value: "6" }
