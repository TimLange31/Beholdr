+            #
+            # ASP.NET Core (Beholdr's defaults):
+            # - { name: BEHOLDR_SERVICE_HTTP_REQUESTS_METRIC, value: "aspnetcore_requests_duration_seconds_count" }
+            # - { name: BEHOLDR_SERVICE_HTTP_STATUS_LABEL, value: "code" }
+            # OpenTelemetry semantic conventions:
+            # - { name: BEHOLDR_SERVICE_HTTP_REQUESTS_METRIC, value: "http_server_request_duration_seconds_count" }
+            # - { name: BEHOLDR_SERVICE_HTTP_STATUS_LABEL, value: "http_response_status_code" }
+            #
+            # Label names depend on your Prometheus relabeling. The app labels
+            # default to kubernetes_namespace / app_kubernetes_io_name; the
+            # cAdvisor and kube-state-metrics labels to namespace / pod.
+            # - { name: BEHOLDR_SERVICE_APP_NAMESPACE_LABEL, value: "kubernetes_namespace" }
